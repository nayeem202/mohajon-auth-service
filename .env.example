# PostgreSQL
POSTGRES_DB=authdb
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth

# JWT (32+ chars, must be strong in production)
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# Google OAuth (for Google sign-in; leave empty to disable)
GOOGLE_CLIENT_ID=

# CORS origins for web clients (comma separated, * for all in dev)
CORS_ALLOWED_ORIGINS=*
